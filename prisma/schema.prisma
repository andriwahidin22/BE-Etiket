generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  fullName    String    @default("Unknown")
  phoneNumber String    @default("0000000000")
  role        Role      @default(BUYER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]
  reviews Review[]
}

enum Role {
  ADMIN
  BUYER
}

// Ticket Model
model Ticket {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  price       Int
  terms       String?   @db.Text 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems OrderItem[]
}

// Venue Model
model Venue {
  id          Int       @id @default(autoincrement())
  name        String
  year        String
  description String
  photo       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Order Model
model Order {
  id               Int           @id @default(autoincrement())
  orderCode       String        @unique
  visitorName     String
  visitDate       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attendanceStatus AttendanceStatus @default(NOT_ARRIVED)
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  payments        Payment[]
}

enum AttendanceStatus {
  NOT_ARRIVED
  ARRIVED
  EXPIRED
}

// Payment Model
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int
  order           Order     @relation(fields: [orderId], references: [id])
  totalAmount     Int
  paymentStatus   String
  transactionDate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Midtrans Order ID
  midtransOrderId String    @unique
}

// Order Item Model
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  ticketId    Int
  quantity    Int
  ticketPrice Int

  order  Order  @relation(fields: [orderId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// Review Model
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
