generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  namaLengkap String   @default("Unknown")
  nomorTelp   String   @default("0000000000")
  role        Role     @default(PEMBELI)
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  PEMBELI
}

// Model Tiket
model Ticket {
  id         Int    @id @default(autoincrement())
  kode       String @unique
  jenisTiket String
  hargaTiket Int

  // Relasi ke pemesanan
  pemesanan Pemesanan[]
}

// Model Venue
model Venue {
  id         Int     @id @default(autoincrement())
  kode       String  @unique
  namaVenue  String
  keterangan String
  foto       String?
}

// Model Pemesanan
model Pemesanan {
  id                Int      @id @default(autoincrement())
  kodePemesanan     String   @unique
  namaPengunjung    String
  jenisTiketId      Int
  jenisTiket        Ticket   @relation(fields: [jenisTiketId], references: [id])
  tanggalBerkunjung DateTime
  jumlahTiket       Int
  totalPembelian    Int
  createdAt         DateTime @default(now())

  pembayaran Pembayaran[]
}


// Model Pembayaran
model Pembayaran {
  id               Int       @id @default(autoincrement())
  pemesananId      Int
  pemesanan        Pemesanan @relation(fields: [pemesananId], references: [id])
  totalPembayaran  Int
  statusPembayaran String
  tanggalTransaksi DateTime  @default(now())
}
