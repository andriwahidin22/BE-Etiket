generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  BUYER
}

enum AttendanceStatus {
  NOT_ARRIVED
  ARRIVED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CHALLENGE
  EXPIRED
}

// ==================== MODELS ====================

// ==== User ====
model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  fullName    String    @default("Unknown")
  phoneNumber String    @default("0000000000")
  role        Role      @default(BUYER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders      Order[]
  reviews     Review[]
  payments    Payment[]
}

// ==== Ticket ====
model Ticket {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  price       Int
  terms       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems  OrderItem[]
}

// ==== Venue ====
model Venue {
  id          Int       @id @default(autoincrement())
  name        String
  year        String
  description String
  photo       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==== Order ====
model Order {
  id               Int               @id @default(autoincrement())
  orderCode        String            @unique
  visitorName      String
  visitDate        DateTime
  attendanceStatus AttendanceStatus  @default(NOT_ARRIVED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userId           Int?
  user             User?             @relation(fields: [userId], references: [id])

  payment          Payment?          // <- Diperbaiki, hilangkan @relation
  orderItems       OrderItem[]
}

// ==== Payment ====
model Payment {
  id              Int             @id @default(autoincrement())
  totalAmount     Int
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentMethod   String?
  transactionDate DateTime        @default(now())
  snapToken       String?
  redirectUrl     String?
  settlementTime  DateTime?
  midtransOrderId String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())

  orderId         Int?            @unique
  order           Order?          @relation(fields: [orderId], references: [id])

  userId          Int?
  visitDate       DateTime?
  user            User?           @relation(fields: [userId], references: [id])
}

// ==== Order Item ====
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  ticketId    Int
  quantity    Int
  ticketPrice Int

  order       Order   @relation(fields: [orderId], references: [id])
  ticket      Ticket  @relation(fields: [ticketId], references: [id])
}

// ==== Review ====
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}
