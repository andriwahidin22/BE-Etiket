<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Laporan Penjualan Tiket</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 12px; }
    h1 { text-align: center; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #000; padding: 5px; text-align: left; }
    .total { font-weight: bold; }
    .section { margin-top: 30px; }
  </style>
</head>
<body>
  <h1>Laporan Penjualan Tiket</h1>
  <p>Periode: <%= periodLabel %></p>

  <% Object.entries(summary).forEach(([date, data]) => { %>
    <div class="section">
      <h3><%= date %></h3>
      <table>
        <thead>
          <tr>
            <th>Jenis Tiket</th>
            <th>Total Pendapatan</th>
          </tr>
        </thead>
        <tbody>
          <% Object.entries(data.byCategory).forEach(([type, total]) => { %>
            <tr>
              <td><%= type %></td>
              <td>Rp <%= total.toLocaleString("id-ID") %></td>
            </tr>
          <% }); %>
          <tr class="total">
            <td>Total</td>
            <td>Rp <%= data.total.toLocaleString("id-ID") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% }); %>

  <h3>Total Keseluruhan: Rp <%= totalAll.toLocaleString("id-ID") %></h3>

  <div class="section">
    <h2>Detail Transaksi</h2>
    <% orders.forEach(order => { %>
      <div>
        <h4>Kode Order: <%= order.orderCode %></h4>
        <p>Nama Pengunjung: <%= order.visitorName || order.user?.fullName || "Tidak tersedia" %></p>
        <p>Metode Pembayaran: <%= order.payment?.paymentMethod || "Tidak tersedia" %></p>
        <p>Tanggal Kunjungan: <%= new Date(order.visitDate).toLocaleDateString("id-ID") %></p>

        <table>
          <thead>
            <tr>
              <th>Jenis Tiket</th>
              <th>Harga</th>
              <th>Jumlah</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% order.orderItems.forEach(item => { %>
              <tr>
                <td><%= item.ticket?.type %></td>
                <td>Rp <%= item.ticketPrice.toLocaleString("id-ID") %></td>
                <td><%= item.quantity %></td>
                <td>Rp <%= item.totalPrice.toLocaleString("id-ID") %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <br/>
      </div>
    <% }); %>
  </div>
</body>
</html>
