<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Laporan Penjualan Tiket</title>
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      font-size: 12px;
      margin: 40px;
      color: #333;
    }

    header {
      text-align: center;
      margin-bottom: 30px;
    }

    h1 {
      margin: 0;
      font-size: 20px;
    }

    h2, h3 {
      margin-bottom: 5px;
      color: #444;
    }

    p {
      margin: 3px 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      margin-bottom: 20px;
    }

    th, td {
      border: 1px solid #aaa;
      padding: 6px 8px;
      font-size: 12px;
    }

    th {
      background-color: #f0f0f0;
      text-align: center;
    }

    td {
      vertical-align: top;
    }

    td.right {
      text-align: right;
    }

    .total {
      font-weight: bold;
      background-color: #f9f9f9;
    }

    .section {
      margin-top: 40px;
    }

    footer {
      margin-top: 50px;
      text-align: center;
      font-size: 10px;
      color: #777;
    }

    .page-break {
      page-break-before: always;
    }
  </style>
</head>
<body>
  <header>
    <h1>Laporan Penjualan Tiket</h1>
    <p>Periode: <%= periodLabel %></p>
  </header>

  <% Object.entries(summary).forEach(([date, data]) => { %>
    <div class="section">
      <h3>Tanggal: <%= date %></h3>
      <table>
        <thead>
          <tr>
            <th>Jenis Tiket</th>
            <th>Total Pendapatan</th>
          </tr>
        </thead>
        <tbody>
          <% Object.entries(data.byCategory).forEach(([type, total]) => { %>
            <tr>
              <td><%= type %></td>
              <td class="right">Rp <%= total.toLocaleString("id-ID") %></td>
            </tr>
          <% }); %>
          <tr class="total">
            <td>Total Harian</td>
            <td class="right">Rp <%= data.total.toLocaleString("id-ID") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% }); %>

  <div class="section">
    <h3>Total Keseluruhan</h3>
    <table>
      <tr class="total">
        <td><strong>Total Pendapatan</strong></td>
        <td class="right"><strong>Rp <%= totalAll.toLocaleString("id-ID") %></strong></td>
      </tr>
    </table>
  </div>

  <div class="section page-break">
    <h2>Detail Transaksi</h2>
    <% orders.forEach(order => { %>
      <div style="margin-bottom: 25px;">
        <h3>Order: <%= order.orderCode %></h3>
        <p><strong>Nama Pengunjung:</strong> <%= order.visitorName || order.user?.fullName || "Tidak tersedia" %></p>
        <p><strong>Tanggal Kunjungan:</strong> <%= new Date(order.visitDate).toLocaleDateString("id-ID") %></p>
        <p><strong>Metode Pembayaran:</strong> <%= order.payment?.paymentMethod || "Tidak tersedia" %></p>

        <table>
          <thead>
            <tr>
              <th>Jenis Tiket</th>
              <th>Harga</th>
              <th>Jumlah</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% order.orderItems.forEach(item => { %>
              <tr>
                <td><%= item.ticket?.type %></td>
                <td class="right">Rp <%= item.ticketPrice.toLocaleString("id-ID") %></td>
                <td class="right"><%= item.quantity %></td>
                <td class="right">Rp <%= item.totalPrice.toLocaleString("id-ID") %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </div>

  <footer>
    <p>Dicetak oleh sistem - <%= new Date().toLocaleDateString("id-ID") %></p>
  </footer>
</body>
</html>
