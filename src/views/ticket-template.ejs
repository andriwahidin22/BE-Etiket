<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Ticket Museum Lampung</title>
  <style>
    @page {
      size: 143mm 50mm;
      margin: 0;
    }
    body {
      font-family: 'Arial', sans-serif;
      margin: 0;
      padding: 0;
      width: 143mm;
      height: 50mm;
      background: #ffffff;
    }
    .ticket {
      width: 100%;
      height: 100%;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 5mm;
      box-sizing: border-box;
      display: flex;
      position: relative;
      overflow: hidden;
    }
    .ticket::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 8mm;
      height: 100%;
      background: var(--ticket-color, #1E90FF);
    }
    .ticket-content {
      display: flex;
      width: 100%;
      height: 100%;
    }
    .ticket-info {
      flex: 1;
      padding: 0 5mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .ticket-header {
      margin-bottom: 3mm;
    }
    .ticket-title {
      font-size: 16px;
      font-weight: bold;
      color: #333;
      margin-bottom: 2mm;
    }
    .ticket-type {
      font-size: 14px;
      font-weight: bold;
      color: var(--ticket-color, #1E90FF);
      margin-bottom: 1mm;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 35mm 1fr;
      gap: 1mm 2mm;
      font-size: 12px;
    }
    .info-label {
      font-weight: bold;
      color: #666;
    }
    .info-value {
      color: #333;
    }
    .price {
      font-weight: bold;
      color: #d9534f;
    }
    .qr-container {
      width: 40mm;
      height: 40mm;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #eee;
      padding: 1mm;
      align-self: center;
    }
    .qr-container img {
      max-width: 100%;
      max-height: 100%;
    }
    .footer {
      font-size: 10px;
      color: #999;
      text-align: center;
      margin-top: 2mm;
    }
  </style>
</head>
<body>
  <% ticketsToRender.forEach(ticket => { %>
    <div class="ticket" style="--ticket-color: <%- ticket.color || '#1E90FF' %>">
      <div class="ticket-content">
        <div class="ticket-info">
          <div class="ticket-header">
            <div class="ticket-title">E-TIKET MUSEUM LAMPUNG</div>
          </div>
          
          <div class="info-grid">
            <div class="info-label">Kode Pemesanan:</div>
            <div class="info-value"><%= order.orderCode %></div>
            
            <div class="info-label">Tanggal Kunjungan:</div>
            <div class="info-value">
              <%= new Date(order.visitDate).toLocaleDateString('id-ID', { 
                day: 'numeric', 
                month: 'long', 
                year: 'numeric' 
              }) %>
            </div>
            
            <div class="info-label">Pengunjung:</div>
            <div class="info-value"><%= order.visitorName %></div>
            
            <div class="info-label">Email:</div>
            <div class="info-value"><%= user.email %></div>
            
            <div class="info-label">Harga:</div>
            <div class="info-value price">Rp <%= ticket.ticketPrice.toLocaleString('id-ID') %></div>
          </div>
          
          <div class="footer">
            Tunjukkan tiket ini saat masuk • Tidak bisa dipindahtangankan
          </div>
        </div>
        
        <div class="qr-container">
          <img src="https://api.qrserver.com/v1/create-qr-code/?data=<%= encodeURIComponent(ticket.qrCode) %>&size=200x200&margin=0" alt="QR Code" />
        </div>
      </div>
    </div>
  <% }) %>
</body>
</html>